# Tested images versions.
# Replace with any suitable version or even "latest" if needed.
BLALALA_BASE_IMAGE=python:3.11-slim
OLLAMA_IMAGE=ollama/ollama:0.30.8

# Tested LLM.
# Replace with any suitable model.
BLALALA_LLM_MODEL=qwen3:8b

# Container-internal ports (should usually be left unchanged).
BLALALA_INTERNAL_PORT=3000
OLLAMA_INTERNAL_PORT=11434

# Public-facing (host) ports.
BLALALA_EXPOSED_PORT=3000

# Dev Test and Debug
DEBUG=true