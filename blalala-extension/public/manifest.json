{
    "manifest_version": 3,
    "name": "Blalala",
    "version": "1.0.0",
    "description": "TBD",

    "action": {
        "default_title": "Blalala",
        "default_popup": "popup.html"
    },

    "permissions": ["activeTab", "scripting"],

    "host_permissions": [
        "http://127.0.0.1:3000/*",
        "http://localhost:3000/*"
    ],

    "browser_specific_settings": {
        "gecko": {
            "id": "blalala@yvesguillo.ch"
        }
    }
}